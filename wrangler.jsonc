{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tend as one Cloudflare Worker, built by OpenNext (docs/SPEC.md section 13).
  // worker/index.ts wraps the generated .open-next/worker.js and adds the cron.
  "name": "tend",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat is required by OpenNext; global_fetch_strictly_public keeps
  // the server's own fetches (Turso, Turnstile) on the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only at its custom domain; Cloudflare creates the DNS record and
  // certificate when a deploy with OAuth or DNS rights first attaches it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tend.n8builds.dev", "custom_domain": true }],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "tend" },
    // Every email (sign-in links, reminders) goes through the shared mailroom,
    // which counts it against the account-wide Cloudflare Email cap. Tend's
    // caps there: 30 a day, 150 a month, 8 per recipient a day.
    { "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom", "props": { "app": "tend" } }
  ],
  // The reminder run (lib/server/reminders.ts), called directly by worker/cron.ts.
  // "server-only" only guards against client bundles, which this entry is not.
  "alias": { "server-only": "./worker/server-only.ts" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_URL": "https://tend.n8builds.dev",
    "AUTH_URL": "https://tend.n8builds.dev",
    "EMAIL_FROM": "tend@n8builds.dev"
  },
  // Secrets (wrangler secret put <NAME>, values in pass under tend/):
  // AUTH_SECRET, DATA_ENCRYPTION_KEY, CRON_SECRET, TURSO_DATABASE_URL,
  // TURSO_AUTH_TOKEN, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY (email sign-in
  // is refused without the two Turnstile keys); optional AUTH_GITHUB_ID,
  // AUTH_GITHUB_SECRET, and VAPID_PRIVATE_KEY for phone notifications (Web
  // Push; the public key is derived from it), GOOGLE_CLIENT_ID and
  // GOOGLE_CLIENT_SECRET for Google Contacts import (docs/SPEC.md).
  // Run next to the Turso database: every page makes several queries.
  "placement": { "mode": "targeted", "region": "aws:us-east-2" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
