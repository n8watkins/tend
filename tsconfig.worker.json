{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    // The cron imports the reminder code, which uses the @/ alias (worker/cron.ts).
    "paths": { "@/*": ["./*"] }
  },
  "include": ["worker/**/*.ts", "cloudflare-env.d.ts"]
}
